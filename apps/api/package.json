{
  "name": "@grocery-shop/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit && tsc --project tsconfig.build.json",
    "test": "node --import tsx --test src/modules/locale.test.ts src/modules/products/decimal.test.ts src/modules/products/image-url.test.ts src/modules/products/image.routes.test.ts",
    "admin:create": "tsx src/db/create-admin.ts",
    "db:create": "tsx src/db/create-database.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@types/cookie-parser": "^1.4.10",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.3",
    "file-type": "^22.3.0",
    "multer": "^2.5.0",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
